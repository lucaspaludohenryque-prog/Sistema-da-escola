generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDENACAO
  PROFESSOR
  RESPONSAVEL
  ALUNO
}

enum Shift {
  MANHA
  TARDE
  NOITE
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  JUSTIFICADA
}

enum OccurrenceType {
  INDISCIPLINA
  ATRASO
  SEM_MATERIAL
  USO_CELULAR
  ELOGIO
  OUTRO
}

enum OccurrenceSeverity {
  LEVE
  MEDIA
  GRAVE
}

enum OccurrenceStatus {
  PENDENTE
  RESOLVIDO
}

enum NotificationType {
  FALTA
  OCORRENCIA
  COMUNICADO
}

enum SchoolEventType {
  PROVA
  TRABALHO
  FERIADO
  REUNIAO
  EVENTO
}

enum LessonPlanStatus {
  PLANEJADO
  MINISTRADO
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANTE
  URGENTE
}

enum JustificationStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  password                String
  role                    UserRole               @default(PROFESSOR)
  active                  Boolean                @default(true)
  classrooms              Classroom[]
  occurrences             Occurrence[]
  guardianLinks           GuardianStudent[]
  studentProfile          Student?
  notifications           Notification[]
  schoolEvents            SchoolEvent[]
  councilMinutes          ClassCouncilMinute[]
  announcements           Announcement[]
  submittedJustifications AbsenceJustification[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([role])
  @@index([active])
  @@map("users")
}

model SchoolConfig {
  id           Int      @id @default(1)
  name         String   @default("Sistema Escolar RCO")
  city         String   @default("")
  state        String   @default("PR")
  phone        String   @default("")
  schoolYear   Int      @default(2026)
  logoUrl      String?
  primaryColor String   @default("#1d4ed8")
  updatedAt    DateTime @updatedAt

  @@map("school_config")
}

model Classroom {
  id             String               @id @default(cuid())
  name           String
  subject        String
  year           Int
  shift          Shift
  teacherId      String
  teacher        User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students       Student[]
  lessons        Lesson[]
  occurrences    Occurrence[]
  assessments    Assessment[]
  scheduleSlots  ScheduleSlot[]
  schoolEvents   SchoolEvent[]
  termRecoveries TermRecovery[]
  termLocks      TermLock[]
  lessonPlans    LessonPlan[]
  councilMinutes ClassCouncilMinute[]
  announcements  Announcement[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([teacherId])
  @@index([year, shift])
  @@map("classrooms")
}

model Student {
  id                    String                 @id @default(cuid())
  name                  String
  registration          String                 @unique
  guardianName          String
  guardianPhone         String
  active                Boolean                @default(true)
  classroomId           String
  classroom             Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances           Attendance[]
  occurrences           Occurrence[]
  grades                Grade[]
  guardianLinks         GuardianStudent[]
  notifications         Notification[]
  termRecoveries        TermRecovery[]
  absenceJustifications AbsenceJustification[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([classroomId, name])
  @@index([active])
  @@map("students")
}

model GuardianStudent {
  id           String   @id @default(cuid())
  guardianId   String
  guardian     User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   @default("Responsável")
  createdAt    DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_students")
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  referenceKey   String?
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())

  @@unique([recipientId, referenceKey])
  @@index([recipientId, createdAt])
  @@index([studentId, referenceKey])
  @@map("notifications")
}

model Lesson {
  id           String       @id @default(cuid())
  classroomId  String
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date         String
  lessonNumber Int          @default(1)
  content      String
  observations String?
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([classroomId, date, lessonNumber])
  @@index([classroomId, date])
  @@map("lessons")
}

model Attendance {
  id            String                @id @default(cuid())
  lessonId      String
  lesson        Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        AttendanceStatus      @default(PRESENTE)
  justification AbsenceJustification?
  updatedAt     DateTime              @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("attendances")
}

model Occurrence {
  id             String             @id @default(cuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId       String
  author         User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type           OccurrenceType
  severity       OccurrenceSeverity
  description    String
  status         OccurrenceStatus   @default(PENDENTE)
  resolutionNote String?
  date           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([classroomId, date])
  @@index([studentId])
  @@index([status, severity])
  @@map("occurrences")
}

model Assessment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title       String
  term        Int
  maxScore    Float     @default(10.0)
  weight      Float     @default(1.0)
  date        String
  grades      Grade[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId, term, date])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("grades")
}

model ScheduleSlot {
  id           String    @id @default(cuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  lessonNumber Int
  startTime    String
  endTime      String
  room         String?
  createdAt    DateTime  @default(now())

  @@unique([classroomId, dayOfWeek, lessonNumber])
  @@index([dayOfWeek, lessonNumber])
  @@map("schedule_slots")
}

model SchoolEvent {
  id          String          @id @default(cuid())
  title       String
  description String?
  date        String
  type        SchoolEventType
  classroomId String?
  classroom   Classroom?      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([classroomId, date])
  @@map("school_events")
}

model TermRecovery {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term        Int
  score       Float
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, studentId, term])
  @@index([classroomId, term])
  @@index([studentId])
  @@map("term_recoveries")
}

model TermLock {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  locked      Boolean   @default(false)
  lockedAt    DateTime?
  lockedById  String?
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, term])
  @@map("term_locks")
}

model LessonPlan {
  id          String           @id @default(cuid())
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  plannedDate String?
  topic       String
  objectives  String?
  status      LessonPlanStatus @default(PLANEJADO)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([classroomId, term])
  @@map("lesson_plans")
}

model ClassCouncilMinute {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  date        String
  summary     String
  decisions   String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, term])
  @@map("class_council_minutes")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  priority    AnnouncementPriority @default(NORMAL)
  pinned      Boolean              @default(false)
  classroomId String?
  classroom   Classroom?           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  @@index([pinned, createdAt])
  @@index([classroomId, createdAt])
  @@map("announcements")
}

model AbsenceJustification {
  id           String              @id @default(cuid())
  attendanceId String              @unique
  attendance   Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     User                @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  reason       String
  status       JustificationStatus @default(PENDENTE)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([guardianId, createdAt])
  @@map("absence_justifications")
}
