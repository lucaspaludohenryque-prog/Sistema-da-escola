generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDENACAO
  PROFESSOR
  RESPONSAVEL
  ALUNO
}

enum Shift {
  MANHA
  TARDE
  NOITE
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  JUSTIFICADA
}

enum OccurrenceType {
  INDISCIPLINA
  ATRASO
  SEM_MATERIAL
  USO_CELULAR
  ELOGIO
  OUTRO
}

enum OccurrenceSeverity {
  LEVE
  MEDIA
  GRAVE
}

enum OccurrenceStatus {
  PENDENTE
  RESOLVIDO
}

enum NotificationType {
  FALTA
  OCORRENCIA
  COMUNICADO
}

enum SchoolEventType {
  PROVA
  TRABALHO
  FERIADO
  REUNIAO
  EVENTO
}

enum LessonPlanStatus {
  PLANEJADO
  MINISTRADO
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANTE
  URGENTE
}

enum JustificationStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

enum HomeworkType {
  TAREFA
  TRABALHO
  MATERIAL
  LEITURA
}

enum HomeworkSubmissionStatus {
  PENDENTE
  ENTREGUE
  ATRASADO
  CONFERIDO
}

enum BadgeCategory {
  FREQUENCIA_100
  DESTAQUE_ACADEMICO
  EVOLUCAO
  COLABORACAO
  LIDERANCA
}

enum VerificationDocType {
  BOLETIM
  ATA_CONSELHO
}

enum ThreadStatus {
  ABERTO
  ENCERRADO
}

enum MeetingMode {
  PRESENCIAL
  ONLINE
}

enum MeetingStatus {
  CONVOCADA
  CONFIRMADA
  REMARCAR
  CONCLUIDA
  CANCELADA
}

enum GateCheckInType {
  ENTRADA
  ATRASO
  SAIDA
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String                 @unique
  password                String
  role                    UserRole               @default(PROFESSOR)
  active                  Boolean                @default(true)
  classrooms              Classroom[]
  occurrences             Occurrence[]
  guardianLinks           GuardianStudent[]
  studentProfile          Student?
  notifications           Notification[]
  schoolEvents            SchoolEvent[]
  councilMinutes          ClassCouncilMinute[]
  announcements           Announcement[]
  submittedJustifications AbsenceJustification[]
  homeworks               Homework[]
  awardedBadges           StudentBadge[]
  guardianThreads         MessageThread[]        @relation("GuardianThreads")
  staffThreads            MessageThread[]        @relation("StaffThreads")
  sentMessages            DirectMessage[]
  guardianMeetings        Meeting[]              @relation("GuardianMeetings")
  organizedMeetings       Meeting[]              @relation("OrganizerMeetings")
  gateCheckIns            GateCheckIn[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([role])
  @@index([active])
  @@map("users")
}

model SchoolConfig {
  id              Int      @id @default(1)
  name            String   @default("Sistema Escolar RCO")
  city            String   @default("")
  state           String   @default("PR")
  phone           String   @default("")
  schoolYear      Int      @default(2026)
  logoUrl         String?
  primaryColor    String   @default("#1d4ed8")
  demoModeEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("school_config")
}

model Classroom {
  id             String               @id @default(cuid())
  name           String
  subject        String
  year           Int
  shift           Shift
  seatRows        Int                  @default(5)
  seatCols        Int                  @default(6)
  teacherId       String
  teacher         User                 @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students        Student[]
  lessons         Lesson[]
  occurrences     Occurrence[]
  assessments     Assessment[]
  scheduleSlots   ScheduleSlot[]
  schoolEvents    SchoolEvent[]
  termRecoveries  TermRecovery[]
  termLocks       TermLock[]
  lessonPlans     LessonPlan[]
  councilMinutes  ClassCouncilMinute[]
  announcements   Announcement[]
  seatAssignments SeatAssignment[]
  homeworks       Homework[]
  studentBadges   StudentBadge[]
  gateCheckIns    GateCheckIn[]
  createdAt       DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([teacherId])
  @@index([year, shift])
  @@map("classrooms")
}

model Student {
  id                    String                 @id @default(cuid())
  name                  String
  registration          String                 @unique
  guardianName          String
  guardianPhone         String
  active                Boolean                @default(true)
  classroomId           String
  classroom             Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances           Attendance[]
  occurrences           Occurrence[]
  grades                Grade[]
  guardianLinks         GuardianStudent[]
  notifications         Notification[]
  termRecoveries        TermRecovery[]
  absenceJustifications AbsenceJustification[]
  seatAssignments       SeatAssignment[]
  homeworkSubmissions   HomeworkSubmission[]
  badges                StudentBadge[]
  messageThreads        MessageThread[]
  meetings              Meeting[]
  gateCheckIns          GateCheckIn[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([classroomId, name])
  @@index([active])
  @@map("students")
}

model GuardianStudent {
  id           String   @id @default(cuid())
  guardianId   String
  guardian     User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   @default("Responsável")
  createdAt    DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_students")
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  referenceKey   String?
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())

  @@unique([recipientId, referenceKey])
  @@index([recipientId, createdAt])
  @@index([studentId, referenceKey])
  @@map("notifications")
}

model Lesson {
  id           String       @id @default(cuid())
  classroomId  String
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date         String
  lessonNumber Int          @default(1)
  content      String
  observations String?
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([classroomId, date, lessonNumber])
  @@index([classroomId, date])
  @@map("lessons")
}

model Attendance {
  id            String                @id @default(cuid())
  lessonId      String
  lesson        Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        AttendanceStatus      @default(PRESENTE)
  justification AbsenceJustification?
  updatedAt     DateTime              @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("attendances")
}

model Occurrence {
  id             String             @id @default(cuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId       String
  author         User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type           OccurrenceType
  severity       OccurrenceSeverity
  description    String
  status         OccurrenceStatus   @default(PENDENTE)
  resolutionNote String?
  date           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([classroomId, date])
  @@index([studentId])
  @@index([status, severity])
  @@map("occurrences")
}

model Assessment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title       String
  term        Int
  maxScore    Float     @default(10.0)
  weight      Float     @default(1.0)
  date        String
  grades      Grade[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId, term, date])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("grades")
}

model ScheduleSlot {
  id           String    @id @default(cuid())
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  lessonNumber Int
  startTime    String
  endTime      String
  room         String?
  createdAt    DateTime  @default(now())

  @@unique([classroomId, dayOfWeek, lessonNumber])
  @@index([dayOfWeek, lessonNumber])
  @@map("schedule_slots")
}

model SchoolEvent {
  id          String          @id @default(cuid())
  title       String
  description String?
  date        String
  type        SchoolEventType
  classroomId String?
  classroom   Classroom?      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([classroomId, date])
  @@map("school_events")
}

model TermRecovery {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term        Int
  score       Float
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, studentId, term])
  @@index([classroomId, term])
  @@index([studentId])
  @@map("term_recoveries")
}

model TermLock {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  locked      Boolean   @default(false)
  lockedAt    DateTime?
  lockedById  String?
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, term])
  @@map("term_locks")
}

model LessonPlan {
  id          String           @id @default(cuid())
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  plannedDate String?
  topic       String
  objectives  String?
  status      LessonPlanStatus @default(PLANEJADO)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([classroomId, term])
  @@map("lesson_plans")
}

model ClassCouncilMinute {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  term        Int
  date        String
  summary     String
  decisions   String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, term])
  @@map("class_council_minutes")
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  priority    AnnouncementPriority @default(NORMAL)
  pinned      Boolean              @default(false)
  classroomId String?
  classroom   Classroom?           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime             @default(now())

  @@index([pinned, createdAt])
  @@index([classroomId, createdAt])
  @@map("announcements")
}

model AbsenceJustification {
  id           String              @id @default(cuid())
  attendanceId String              @unique
  attendance   Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     User                @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  reason       String
  status       JustificationStatus @default(PENDENTE)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([guardianId, createdAt])
  @@map("absence_justifications")
}

model SeatAssignment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  row         Int
  col         Int
  updatedAt   DateTime  @updatedAt

  @@unique([classroomId, row, col])
  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@map("seat_assignments")
}

model Homework {
  id          String               @id @default(cuid())
  classroomId String
  classroom   Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  description String
  dueDate     String
  resourceUrl String?
  type        HomeworkType         @default(TAREFA)
  submissions HomeworkSubmission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([classroomId, dueDate])
  @@index([dueDate])
  @@map("homeworks")
}

model HomeworkSubmission {
  id              String                   @id @default(cuid())
  homeworkId      String
  homework        Homework                 @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          HomeworkSubmissionStatus @default(PENDENTE)
  studentNote     String?
  teacherFeedback String?
  submittedAt     DateTime?
  updatedAt       DateTime                 @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId, status])
  @@map("homework_submissions")
}

model StudentBadge {
  id          String        @id @default(cuid())
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  category    BadgeCategory
  title       String
  reason      String
  awardedById String
  awardedBy   User          @relation(fields: [awardedById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())

  @@index([studentId, createdAt])
  @@index([classroomId, createdAt])
  @@map("student_badges")
}

model DocumentVerification {
  id            String              @id @default(cuid())
  code          String              @unique
  docType       VerificationDocType
  title         String
  subjectName   String
  classroomName String
  summaryJson   String
  issuedByName  String
  issuedAt      DateTime            @default(now())

  @@index([issuedAt])
  @@map("document_verifications")
}

model MessageThread {
  id         String          @id @default(cuid())
  subject    String
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   User            @relation("GuardianThreads", fields: [guardianId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      User?           @relation("StaffThreads", fields: [staffId], references: [id], onDelete: SetNull)
  status     ThreadStatus    @default(ABERTO)
  messages   DirectMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([guardianId, updatedAt])
  @@index([studentId, updatedAt])
  @@index([status, updatedAt])
  @@map("message_threads")
}

model DirectMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@map("direct_messages")
}

model Meeting {
  id             String        @id @default(cuid())
  title          String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId     String
  guardian       User          @relation("GuardianMeetings", fields: [guardianId], references: [id], onDelete: Cascade)
  organizerId    String
  organizer      User          @relation("OrganizerMeetings", fields: [organizerId], references: [id], onDelete: Restrict)
  date           String
  time           String
  mode           MeetingMode   @default(PRESENCIAL)
  locationOrLink String
  notes          String?
  status         MeetingStatus @default(CONVOCADA)
  guardianNote   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([guardianId, date])
  @@index([organizerId, date])
  @@index([studentId, date])
  @@map("meetings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  userRole  String
  action    String
  entity    String
  entityId  String?
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userRole, createdAt])
  @@map("audit_logs")
}

model GateCheckIn {
  id           String          @id @default(cuid())
  studentId    String
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId  String
  classroom    Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User            @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  date         String
  time         String
  type         GateCheckInType @default(ENTRADA)
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([date, createdAt])
  @@index([studentId, date, type])
  @@index([classroomId, date])
  @@map("gate_check_ins")
}
