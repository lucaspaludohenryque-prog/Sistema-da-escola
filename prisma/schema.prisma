generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDENACAO
  PROFESSOR
  RESPONSAVEL
  ALUNO
}

enum Shift {
  MANHA
  TARDE
  NOITE
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  JUSTIFICADA
}

enum OccurrenceType {
  INDISCIPLINA
  ATRASO
  SEM_MATERIAL
  USO_CELULAR
  ELOGIO
  OUTRO
}

enum OccurrenceSeverity {
  LEVE
  MEDIA
  GRAVE
}

enum OccurrenceStatus {
  PENDENTE
  RESOLVIDO
}

enum NotificationType {
  FALTA
  OCORRENCIA
  COMUNICADO
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String
  role           UserRole          @default(PROFESSOR)
  active         Boolean           @default(true)
  classrooms     Classroom[]
  occurrences    Occurrence[]
  guardianLinks  GuardianStudent[]
  studentProfile Student?
  notifications  Notification[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([role])
  @@index([active])
  @@map("users")
}

model SchoolConfig {
  id           Int      @id @default(1)
  name         String   @default("Sistema Escolar RCO")
  city         String   @default("")
  state        String   @default("PR")
  phone        String   @default("")
  schoolYear   Int      @default(2026)
  logoUrl      String?
  primaryColor String   @default("#1d4ed8")
  updatedAt    DateTime @updatedAt

  @@map("school_config")
}

model Classroom {
  id          String       @id @default(cuid())
  name        String
  subject     String
  year        Int
  shift       Shift
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  students    Student[]
  lessons     Lesson[]
  occurrences Occurrence[]
  assessments Assessment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teacherId])
  @@index([year, shift])
  @@map("classrooms")
}

model Student {
  id            String            @id @default(cuid())
  name          String
  registration  String            @unique
  guardianName  String
  guardianPhone String
  active        Boolean           @default(true)
  classroomId   String
  classroom     Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId        String?           @unique
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances   Attendance[]
  occurrences   Occurrence[]
  grades        Grade[]
  guardianLinks GuardianStudent[]
  notifications Notification[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([classroomId, name])
  @@index([active])
  @@map("students")
}

model GuardianStudent {
  id           String   @id @default(cuid())
  guardianId   String
  guardian     User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   @default("Responsável")
  createdAt    DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@map("guardian_students")
}

model Notification {
  id             String           @id @default(cuid())
  recipientId    String
  recipient      User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           NotificationType
  title          String
  message        String
  referenceKey   String?
  readAt         DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime         @default(now())

  @@unique([recipientId, referenceKey])
  @@index([recipientId, createdAt])
  @@index([studentId, referenceKey])
  @@map("notifications")
}

model Lesson {
  id           String       @id @default(cuid())
  classroomId  String
  classroom    Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date         String
  lessonNumber Int          @default(1)
  content      String
  observations String?
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([classroomId, date, lessonNumber])
  @@index([classroomId, date])
  @@map("lessons")
}

model Attendance {
  id        String           @id @default(cuid())
  lessonId  String
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENTE)
  updatedAt DateTime         @updatedAt

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@map("attendances")
}

model Occurrence {
  id             String             @id @default(cuid())
  studentId      String
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorId       String
  author         User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  type           OccurrenceType
  severity       OccurrenceSeverity
  description    String
  status         OccurrenceStatus   @default(PENDENTE)
  resolutionNote String?
  date           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([classroomId, date])
  @@index([studentId])
  @@index([status, severity])
  @@map("occurrences")
}

model Assessment {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  title       String
  term        Int
  maxScore    Float     @default(10.0)
  weight      Float     @default(1.0)
  date        String
  grades      Grade[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([classroomId, term, date])
  @@map("assessments")
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Float
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("grades")
}
