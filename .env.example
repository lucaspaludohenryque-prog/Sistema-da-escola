# String de conexao PostgreSQL (Neon, Supabase, Vercel Postgres ou local)
# Exemplo: postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
DATABASE_URL="postgresql://usuario:senha@host:5432/sistema_escolar?sslmode=require"

# Segredo criptografico para assinatura JWT HS256 (minimo 32 caracteres em producao)
# Gere com: openssl rand -base64 48
JWT_SECRET="substitua-por-uma-chave-secreta-forte-de-pelo-menos-32-caracteres"
